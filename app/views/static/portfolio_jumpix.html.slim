					.col-md-6

						= link_to image_path("portfolio/jumpix/jumpix-mobile-app-mockups.png"), :class=>"thumbnail", "data-fancybox"=>"gallery", "data-caption"=>"Mobile concepts for accessing and managing cloud content on the go." do
							= image_tag "portfolio/jumpix/jumpix-mobile-designs.jpg", :class=>"img-fluid w-100 h-auto border border-2 border-dark rounded-3 box-shadow", :alt=>"Mobile concepts for accessing and managing cloud content on the go."
						h5.mt-3.mb-2 Mobile App Experience
				.row.mt-3
					.d-inline.mb-5.mb-md-0
						= link_to 'View Jumpix Guide <i class="fad fa-external-link-alt"></i>'.html_safe, '/jumpix/Jumpix_Get_Started.pdf', target: "_blank"

			.card.bg-gradient-soft.p-4
				h6.mb-2 Brand + Marketing
				h3 Building the brand & reaching users
				p.mb-4 Extended the Jumpix experience across marketing and launch initiatives through email, social media, motion graphics, print collateral, and other brand-aligned assets.
				.row.g-4
					.col-md-6

						= link_to "https://www.youtube.com/embed/OXDCorXseHk", :class=>"d-block position-relative", "data-fancybox"=>"gallery", "data-caption"=>"Motion graphics product video introducing the Jumpix platform and features." do
							button.btn-play.position-absolute.top-50.start-50.translate-middle
