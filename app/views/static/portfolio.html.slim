= content_for :body_class, 'portfolio'	

section.hero.d-flex
	.container
		.row.justify-content-center.text-center
			.col-md-10.col-lg-10
				.squiggle
				h1 Design & Web Projects
				p.lead.mb-4 A showcase of digital solutions built to elevate brands, strengthen user experience, and support meaningful outcomes. Discover the strategy, design, and development behind each project. Your project could be next!
				= link_to "Let's Work Together", contact_path, :class=>"btn btn-primary"
				br

/!  Begin Page Content
section.industries.d-none
	.container
		.row.text-center
			h2.mb-5 Honored to Partner with Businesses In
			.col-lg-4
				h6 Technology
				h6 Construction & General Contracting
				h6 Coaching & Consulting
			.col-lg-4
				h6 Health & Wellness
				h6 Beauty & Skincare
				h6 Event Planning
			.col-lg-4
				h6 Performing Arts
				h6 Design & Media
				h6 Social Justice
- visible_rows = 4  # 4 rows x 3 cards = 12 visible
- rows = all_projects.each_slice(3).to_a

section.portfolio-grid.border-top.border-black
  .container
	/ Portfolio Filters
    .portfolio-filters
      .row.g-3
        .col-sm-6.col-md-3
          label.form-label for="industry-filter" Industry
          select.form-select#industry-filter
            option value="all" All Industries
            - portfolio_industries.each do |label, value|
              option value=value = label

        .col-sm-6.col-md-3
          label.form-label for="type-filter" Project Type
          select.form-select#type-filter
            option value="all" All Project Types
            - portfolio_project_types.each do |label, value|
              option value=value = label

	

	/ Portfolio Projects
    - rows.each_with_index do |row_projects, row_index|
      - is_hidden = row_index >= visible_rows

      .row class=(is_hidden ? 'load-card ' : nil)
        - row_projects.each do |project|
          .col-md-4.portfolio-item[
			data-industry=project[:industry]&.join(" ")
			data-project-type=project[:project_type]&.join(" ")
		]
            = link_to project[:path], class: 'portfolio-card card' do
              = image_tag project[:img], class: "card-img", alt: project[:title]
              .card-body.d-flex.flex-column
                h5.card-title = project[:title]
                p.card-text.flex-grow-1 = (project[:desc].presence || project[:label])
                p.text-lowercase View Project »

    - if rows.length > visible_rows
      .row
        #loadMore.mx-auto.center
          a.btn.btn-loadmore.btn-secondary href="#" id="load-more" Load More Projects



